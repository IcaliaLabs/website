---
pagination:
  data: redirects
  size: 1
  alias: redirect
permalink: "{{ redirect.output }}"
eleventyExcludeFromCollections: true
---
{%- set target = collections.all | pageByUrl(redirect.to) -%}
{%- set targetTitle = (target.data.pageTitle or target.data.title) if target else "Icalia Labs" -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Moved: {{ targetTitle }}</title>
  <meta name="robots" content="noindex">
  <link rel="canonical" href="{{ siteUrl }}{{ redirect.to }}">
  <script>
    // Forward with the query string and hash. A redirect hides the original
    // referrer from analytics, so when the visitor came from another site
    // without UTMs, tag the landing URL with that site as the source.
    (function () {
      var to = {{ redirect.to | dump | safe }};
      var query = location.search;
      if (document.referrer && !/[?&]utm_/.test(query)) {
        try {
          var host = new URL(document.referrer).hostname.replace(/^www\./, "");
          if (host && host !== "icalialabs.com") {
            var isSearch = /(^|\.)(google|bing|duckduckgo|yahoo|yandex|baidu|ecosia)\./.test(host);
            var utm = "utm_source=" + encodeURIComponent(host) +
              "&utm_medium=" + (isSearch ? "organic" : "referral") +
              "&utm_campaign=moved-url&utm_content=" + encodeURIComponent(location.pathname);
            query = query ? query + "&" + utm : "?" + utm;
          }
        } catch (e) {}
      }
      location.replace(to + query + location.hash);
    })();
  </script>
  <meta http-equiv="refresh" content="0; url={{ redirect.to }}">
</head>
<body>
<main>
  <h1>This page has moved</h1>
  <p>It now lives at <a href="{{ redirect.to }}">{{ targetTitle }}</a>.</p>
{%- if target and target.data.description %}
  <p>{{ target.data.description }}</p>
{%- endif %}
</main>
</body>
</html>
