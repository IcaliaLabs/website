<!DOCTYPE html>
<html lang="en">
<head>
{% include "head.html" %}
{% set allPosts = collections.posts | newestFirst %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Icalia Labs Blog",
    "description": {{ description | dump | safe }},
    "url": "https://icalialabs.com{{ canonicalPath }}",
    "isPartOf": { "@type": "WebSite", "name": "Icalia Labs", "url": "https://icalialabs.com" },
    "publisher": { "@type": "Organization", "name": "Icalia Labs", "url": "https://icalialabs.com" },
    "mainEntity": {
      "@type": "ItemList",
      "itemListElement": [
{%- for p in allPosts %}
        { "@type": "ListItem", "position": {{ loop.index }}, "url": "https://icalialabs.com{{ p.url }}", "name": {{ p.data.title | dump | safe }} }{% if not loop.last %},{% endif %}
{%- endfor %}
      ]
    }
  }
  </script>
</head>
<body class="font-body text-icalia-dark antialiased bg-icalia-warm">

  <!-- Navigation -->
{% include "nav.html" %}

<main>

  <!-- Hero -->
  <section class="pt-36 pb-12 md:pt-48 md:pb-16 px-6 lg:px-10">
    <div class="max-w-7xl mx-auto">
      <p class="text-sm font-semibold text-icalia-red tracking-wide uppercase mb-6">Icalia Labs Blog</p>
      <h1 class="font-display text-5xl md:text-7xl lg:text-8xl leading-[0.95] tracking-tight max-w-5xl">
        The changelog of<br>
        how we <span class="italic text-icalia-red">build.</span>
      </h1>
      <p class="mt-10 text-lg md:text-xl text-icalia-navy/60 max-w-3xl leading-relaxed">
        Engineers, founders, and operators at Icalia Labs writing about nearshore teams, AI-augmented and agentic engineering, and what it takes to ship. Every entry is dated, so you can tell what we learned before the AI era from what we know now.
      </p>
{% if collections.topicPages.length %}
      <div class="mt-10 flex flex-wrap gap-2" aria-label="Browse by topic">
{% for t in collections.topicPages %}
        <a href="/blog/topics/{{ t.slug }}.html" class="text-sm font-semibold text-icalia-navy bg-white border border-icalia-sand px-4 py-2 rounded-full hover:border-icalia-red hover:text-icalia-red transition-colors">{{ t.label }} <span class="text-icalia-navy/40 font-normal">{{ t.posts.length }}</span></a>
{% endfor %}
      </div>
{% endif %}
    </div>
  </section>

{% if allPosts.length %}
{% set groups = collections.posts | groupByYear %}
  <!-- Timeline navigation -->
  <nav aria-label="Blog timeline" class="sticky top-[76px] z-40 bg-icalia-warm/95 backdrop-blur-md border-y border-icalia-sand/60">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-3 flex items-center gap-2 overflow-x-auto text-sm whitespace-nowrap">
      <span class="text-xs font-semibold uppercase tracking-widest text-icalia-navy/40 mr-2">Timeline</span>
{% for g in groups %}
{% if loop.first and not g.preAi %}
      <span class="text-xs font-semibold uppercase tracking-widest text-icalia-red mx-1">{{ blog.aiEraLabel }}</span>
{% endif %}
{% if g.preAi and (loop.first or not groups[loop.index0 - 1].preAi) %}
      <span class="h-4 w-px bg-icalia-sand mx-2" aria-hidden="true"></span>
      <span class="text-xs font-semibold uppercase tracking-widest text-icalia-navy/40 mx-1">{{ blog.preAiEraLabel }}</span>
{% endif %}
      <a href="#y{{ g.year }}" class="font-semibold px-3 py-1.5 rounded-full {% if g.preAi %}text-icalia-navy/60 hover:bg-icalia-warm-2{% else %}text-icalia-dark hover:bg-white{% endif %} hover:text-icalia-red transition-colors">{{ g.year }}</a>
{% endfor %}
    </div>
  </nav>

  <!-- Timeline -->
  <section class="px-6 lg:px-10 pb-24 md:pb-32" aria-label="Articles by year">
    <div class="max-w-7xl mx-auto">
{% for g in groups %}
{% if g.preAi and (loop.first or not groups[loop.index0 - 1].preAi) %}
      <div class="mt-16 rounded-3xl border border-dashed border-icalia-sand bg-icalia-warm-2 p-8 md:p-10">
        <p class="text-xs font-semibold uppercase tracking-widest text-icalia-navy/50">{{ blog.preAiEraLabel }} &middot; before {{ blog.aiEraStartYear }}</p>
        <p class="mt-3 font-display text-3xl md:text-4xl leading-tight">Written before AI was part of how we build.</p>
        <p class="mt-3 text-icalia-navy/60 leading-relaxed max-w-2xl">The fundamentals still hold. Tooling and workflow advice in these posts may be dated.</p>
      </div>
{% endif %}
      <div id="y{{ g.year }}" class="grid md:grid-cols-12 gap-6 md:gap-10 pt-12 md:pt-16 scroll-mt-36">
        <div class="md:col-span-3 lg:col-span-2">
          <div class="md:sticky md:top-40 flex md:block items-baseline gap-4 md:border-l-2 {% if g.preAi %}md:border-icalia-sand{% else %}md:border-icalia-red{% endif %} md:pl-5">
            <h2 class="font-display text-5xl md:text-6xl leading-none {% if g.preAi %}text-icalia-navy/50{% endif %}">{{ g.year }}</h2>
            <div class="md:mt-3">
              <p class="text-xs font-semibold uppercase tracking-widest {% if g.preAi %}text-icalia-navy/40{% else %}text-icalia-red{% endif %}">{% if g.preAi %}{{ blog.preAiEraLabel }}{% else %}{{ blog.aiEraLabel }}{% endif %}</p>
              <p class="mt-1 text-xs text-icalia-navy/40">{{ g.posts.length }} article{% if g.posts.length != 1 %}s{% endif %}</p>
            </div>
          </div>
        </div>
        <div class="md:col-span-9 lg:col-span-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
{% for card in g.posts %}
{% set cardHeading = "h3" %}
{% if loop.first and g.year == groups[0].year %}
          <div class="sm:col-span-2 lg:col-span-3">
{% set cardFeatured = true %}
{% include "post-card.html" %}
          </div>
{% else %}
{% set cardFeatured = false %}
{% include "post-card.html" %}
{% endif %}
{% endfor %}
        </div>
      </div>
{% endfor %}
    </div>
  </section>
{% else %}
  <section class="pb-24 md:pb-32 px-6 lg:px-10">
    <div class="max-w-3xl mx-auto bg-icalia-warm-2 border border-icalia-sand/60 rounded-3xl p-10 md:p-14 text-center">
      <h2 class="font-display text-3xl md:text-4xl leading-tight">First articles are on the way.</h2>
      <p class="mt-5 text-icalia-navy/60 leading-relaxed">In the meantime, see how we've delivered for other teams or read how we think about building software.</p>
      <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/case-studies.html" class="bg-icalia-dark text-icalia-warm px-8 py-4 rounded-full font-semibold hover:bg-icalia-navy transition-colors">See our case studies</a>
        <a href="/manifesto.html" class="px-8 py-4 rounded-full font-semibold text-icalia-navy hover:text-icalia-dark transition-colors">Read our manifesto</a>
      </div>
    </div>
  </section>
{% endif %}

</main>

  {% include "footer.html" %}

  <script>
    document.getElementById('mobile-menu-btn').addEventListener('click', function() {
      document.getElementById('mobile-menu').classList.toggle('hidden');
    });
    const miToggle = document.getElementById('mobile-industries-toggle');
    if (miToggle) {
      miToggle.addEventListener('click', function() {
        document.getElementById('mobile-industries').classList.toggle('hidden');
        document.getElementById('mobile-industries-chevron').classList.toggle('rotate-180');
      });
    }
  </script>
</body>
</html>
