<!DOCTYPE html>
<html lang="en">
<head>
{% include "head.html" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": {{ topic.label | dump | safe }},
    "description": {{ topic.description | dump | safe }},
    "url": "https://icalialabs.com{{ canonicalPath }}",
    "isPartOf": { "@type": "Blog", "name": "Icalia Labs Blog", "url": "https://icalialabs.com/blog/" },
    "mainEntity": {
      "@type": "ItemList",
      "itemListElement": [
{%- for p in topic.posts %}
        { "@type": "ListItem", "position": {{ loop.index }}, "url": "https://icalialabs.com{{ p.url }}", "name": {{ p.data.title | dump | safe }} }{% if not loop.last %},{% endif %}
{%- endfor %}
      ]
    }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://icalialabs.com/" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://icalialabs.com/blog/" },
      { "@type": "ListItem", "position": 3, "name": {{ topic.label | dump | safe }}, "item": "https://icalialabs.com{{ canonicalPath }}" }
    ]
  }
  </script>
</head>
<body class="font-body text-icalia-dark antialiased bg-icalia-warm">

  <!-- Navigation -->
{% include "nav.html" %}

<main>

  <section class="pt-36 pb-12 md:pt-48 md:pb-16 px-6 lg:px-10">
    <div class="max-w-7xl mx-auto">
      <nav aria-label="Breadcrumb" class="text-xs font-medium text-icalia-navy/50 mb-8">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-icalia-red transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/blog/" class="hover:text-icalia-red transition-colors">Blog</a></li>
        </ol>
      </nav>
      <p class="text-sm font-semibold text-icalia-red tracking-wide uppercase mb-6">Topic</p>
      <h1 class="font-display text-5xl md:text-7xl leading-[0.95] tracking-tight max-w-5xl">{{ topic.label }}</h1>
      <p class="mt-8 text-lg md:text-xl text-icalia-navy/60 max-w-3xl leading-relaxed">{{ topic.description }}</p>
{% if topic.relatedUrl %}
      <a href="{{ topic.relatedUrl }}" class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-icalia-red hover:underline">{{ topic.relatedLabel }} <span aria-hidden="true">→</span></a>
{% endif %}
    </div>
  </section>

  <section class="pb-24 md:pb-32 px-6 lg:px-10" aria-label="Articles">
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 lg:grid-cols-3 gap-6">
{% for p in topic.posts %}
      <a href="{{ p.url }}" class="group flex flex-col bg-white border border-icalia-sand/50 rounded-2xl p-6 hover:border-icalia-red/40 transition-colors">
        <p class="text-xs font-semibold text-icalia-navy/40 uppercase tracking-widest">{{ p.date | readableDate }}</p>
        <h2 class="mt-3 font-display text-2xl leading-snug text-icalia-dark group-hover:text-icalia-red transition-colors">{{ p.data.title }}</h2>
        <p class="mt-3 text-sm text-icalia-navy/60 leading-relaxed">{{ p.data.description }}</p>
      </a>
{% endfor %}
    </div>
  </section>

</main>

  {% include "footer.html" %}

  <script>
    document.getElementById('mobile-menu-btn').addEventListener('click', function() {
      document.getElementById('mobile-menu').classList.toggle('hidden');
    });
    const miToggle = document.getElementById('mobile-industries-toggle');
    if (miToggle) {
      miToggle.addEventListener('click', function() {
        document.getElementById('mobile-industries').classList.toggle('hidden');
        document.getElementById('mobile-industries-chevron').classList.toggle('rotate-180');
      });
    }
  </script>
</body>
</html>
